			var normal: Vector3 = field_agent.get("cover_normal")
			check(normal.dot(Vector3.BACK) > 0.95, "cover normal matches barrier face")
			check(bool(field_agent.call("cover_contact")), "cover remains in contact")
		field_agent.set("cover_requested", true)
		field_agent.call("update_cover")
		check(not bool(field_agent.get("cover_active")), "toggle cover off")
		field_agent.set("cover_requested", true)
		field_agent.call("update_cover")
		check(bool(field_agent.get("cover_active")), "reenter low cover")
		field_agent.global_position = Vector3(-1.7, 0.05, 6.65)
		await get_tree().physics_frame
		await get_tree().physics_frame
		field_agent.call("update_cover")
		check(not bool(field_agent.get("cover_active")), "leave cover at edge")
	hotel.queue_free()
	await get_tree().process_frame
	await check_archive_route("retain", Vector3(5.5, 0.05, 7.0))
	await check_archive_route("share", Vector3(-5.5, 0.05, -3.5))
	Campaign.load_campaign()
	check(Campaign.intel_choice == "retain", "route test restores canonical saved choice")
	var safehouse: Node = preload("res://scenes/safehouse.tscn").instantiate()
	add_child(safehouse)
	await get_tree().physics_frame
	var home_agent := safehouse.get_node_or_null("Agent")
	check(is_instance_valid(home_agent), "safehouse agent exists")
	if is_instance_valid(home_agent):
		check(int(home_agent.get("maximum_health")) == 120, "kit not applied in safehouse")
		check(home_agent.get("combat") == null, "safehouse combat disabled")
		var home_visual: Node3D = home_agent.get("model")
		var home_outfit: Node3D = home_visual.get("outfit")
		check(home_outfit.get_child_count() == 0, "safehouse excludes field outfit")
		check(not bool(home_agent.call("use_distraction")), "safehouse distraction disabled")
		var menu: CanvasLayer = home_agent.get("pause_menu")
		check(is_instance_valid(menu), "pause menu exists")
		if is_instance_valid(menu):
			menu.call("pause_game")
			check(get_tree().paused and bool(menu.get("owns_pause")), "pause suspends scene tree")
			menu.call("resume")
			check(not get_tree().paused and not bool(menu.get("owns_pause")), "resume restores scene tree")
			home_agent.set("controls_enabled", false)
			menu.call("pause_game")
			check(not get_tree().paused, "terminal state cannot pause")
			home_agent.set("controls_enabled", true)
		check(GameSettings.save_effects_volume(0.25), "save effects volume")
		var settings := ConfigFile.new()
		check(settings.load("user://settings.cfg") == OK, "load independent settings")
		check(is_equal_approx(float(settings.get_value("audio", "effects_volume", -1)), 0.25), "volume persisted")
		check(GameSettings.save_effects_volume(1.5) and is_equal_approx(GameSettings.effects_volume, 1.0), "volume clamped")
	safehouse.queue_free()
	await get_tree().process_frame
	check(Campaign.select_deployment_equipment("quiet_kit") and Campaign.equipment_active("quiet_kit"), "switch to owned movement kit")
	await check_relay_scene()
	check(Campaign.select_deployment_equipment("utility_rig") and Campaign.equipment_active("utility_rig"), "switch to utility rig")
	check(Campaign.select_deployment_equipment("") and not Campaign.equipment_active("utility_rig"), "empty slot accepted")
	check_contract_branches()
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	if failures == 0:
		print("CAMPAIGN REGRESSION PASSED")
	get_tree().quit(0 if failures == 0 else 1)

func check_archive_route(choice: String, expected: Vector3) -> void:
	# Only the isolated test changes the in-memory choice; never write it.
	Campaign.intel_choice = choice
	var archive: Node = preload("res://scenes/archive.tscn").instantiate()
	add_child(archive)
	var agent := archive.get_node_or_null("Agent") as CharacterBody3D
	var mission := archive.get_node_or_null("Mission")
	var guard := archive.get_node_or_null("Guard")
	check(is_instance_valid(agent) and is_instance_valid(mission) and is_instance_valid(guard), "archive entities exist")
	if is_instance_valid(agent) and is_instance_valid(mission) and is_instance_valid(guard):
		agent.set_physics_process(false)
		guard.set_physics_process(false)
		check(agent.position.is_equal_approx(expected), choice + " correct spawn")
		var extraction: Vector3 = mission.get("exit_point")
		check(is_equal_approx(extraction.x, expected.x) and is_equal_approx(extraction.z, expected.z), choice + " matching extraction")
		check(guard.get("patrol_points").size() == 4, "archive-specific patrol")
		check(mission.get("operation_id") == "silent_archive", "archive mission identity")
		var radio: Label = mission.get("radio_label")
		check(is_instance_valid(radio), "archive radio exists")
		if is_instance_valid(radio):
			check(radio.visible and radio.text.begins_with("HANDLER" if choice == "share" else "AGENT"), "branch-specific deployment message")
			mission.call("advance_radio", 6.0)
			check(not radio.visible, "radio expires")
			mission.call("show_radio", "Test")
			mission.call("clear_radio")
			check(not radio.visible, "radio clears")
		await get_tree().physics_frame
		await get_tree().physics_frame
		check(bool(mission.call("can_reach", extraction)), choice + " extraction reachable at spawn")
		agent.global_position = Vector3(-3.0, 0.05, -5.0)
		await get_tree().physics_frame
		await get_tree().physics_frame
		check(bool(mission.call("can_reach", mission.get("intel_point"))), choice + " ledger reachable")
	archive.queue_free()
	await get_tree().process_frame

func check_contract_branches() -> void:
	# Standalone campaign instances use the already isolated test save.
	var original := ConfigFile.new()
	if original.load("user://campaign.cfg") != OK:
		check(false, "capture isolated save before alternate branches")
		return
	var clean := {"seconds": 50, "damage": 0, "shots": 0, "hits": 0, "alerted": false, "guard_down": false}
	var official := preload("res://scripts/campaign.gd").new()
	check(official.record_intel("retain", clean), "alternate hotel completion")
	check(official.accept_handler_contract(), "accept official first")
	check(not official.accept_rook_contract(), "official excludes Rook")
	check(official.record_archive(clean), "official archive completion")
	check(official.handler_contract_reward() == 30 and official.earned_credits() == 390 and official.handler_trust() == 0, "official reward and trust settle once")
	check(official.record_archive(clean) and official.earned_credits() == 390, "official replay cannot farm reward")
	check(official.relay_route() == "handler", "fulfilled official contract unlocks west route")
	var reloaded := preload("res://scripts/campaign.gd").new()
	reloaded.load_campaign()
	check(reloaded.handler_contract_accepted and reloaded.earned_credits() == 390 and not reloaded.save_blocked, "official settlement survives reload")
	check(reloaded.record_relay(clean) and reloaded.earned_credits() == 570, "relay completion rewarded once")
	check(reloaded.record_relay(clean) and reloaded.earned_credits() == 570, "relay replay cannot farm")
	reloaded.field_reports.clear()
	reloaded.load_campaign()
	check(reloaded.operation_completed("night_relay") and reloaded.earned_credits() == 570 and not reloaded.save_blocked, "relay survives reload")
	var rook := preload("res://scripts/campaign.gd").new()
	check(rook.record_intel("retain", clean) and rook.accept_rook_contract(), "new Rook terms accepted")
	check(rook.record_archive(clean), "Rook archive completion")
	check(rook.earned_credits() == 395 and rook.handler_trust() == -2 and rook.rook_reputation() == 1, "Rook reward and trust cost settle")
	check(rook.relay_route() == "rook", "fulfilled Rook contract unlocks east route")
	var legacy := ConfigFile.new()
	check(legacy.load("user://campaign.cfg") == OK, "load Rook save")
	legacy.erase_section_key("contacts", "rook_trust_penalty_enabled")
	check(legacy.save("user://campaign.cfg") == OK, "simulate pre-penalty save")
	var old_terms := preload("res://scripts/campaign.gd").new()
	old_terms.load_campaign()
	check(not old_terms.save_blocked and old_terms.earned_credits() == 395 and old_terms.handler_trust() == -1, "legacy Rook contract retains old terms")
	legacy.set_value("contacts", "handler_contract_accepted", true)
	check(legacy.save("user://campaign.cfg") == OK, "simulate conflicting contracts")
	var invalid := preload("res://scripts/campaign.gd").new()
	invalid.load_campaign()
	check(invalid.save_blocked, "dual accepted contracts rejected")
	check(original.save("user://campaign.cfg") == OK, "restore original isolated save")
	official.free()
	reloaded.free()
	rook.free()
	old_terms.free()
	invalid.free()

func check_relay_scene() -> void:
	var relay_script = preload("res://scripts/relay.gd")
	check(relay_script.spawn_for("handler") != relay_script.spawn_for("rook"), "sponsor entrances differ")
	check(relay_script.spawn_for("independent") != relay_script.spawn_for("rook"), "independent entrance differs")
	var relay: Node = preload("res://scenes/relay.tscn").instantiate()
	add_child(relay)
	var agent := relay.get_node_or_null("Agent") as CharacterBody3D
	var mission := relay.get_node_or_null("Mission")
	var guard := relay.get_node_or_null("Guard")
	check(is_instance_valid(agent) and is_instance_valid(mission) and is_instance_valid(guard), "relay entities exist")
	if is_instance_valid(agent) and is_instance_valid(mission) and is_instance_valid(guard):
		agent.set_physics_process(false)
		guard.set_physics_process(false)
		check(mission.get("operation_id") == "night_relay", "relay mission identity")
		var summary: Dictionary = mission.call("security_summary")
		check(summary["count"] == 2 and not summary["alerted"] and summary["down"] == 0, "relay security roster")
		var reserve := relay.get_node_or_null("GuardReserve") as CharacterBody3D
		check(is_instance_valid(reserve), "second relay guard exists")
		if is_instance_valid(reserve):
			reserve.set_physics_process(false)
		check(bool(guard.call("request_distraction")), "guard can investigate before agent request")
		check(not bool(agent.call("use_distraction")) and bool(agent.get("distraction_available")), "rejected use retains charge")
		var gadget_label: Label = agent.get("distraction_label")
		check(gadget_label.text.contains("charge retained"), "rejected use explains charge")
		agent.call("advance_distraction_feedback", 2.0)
		check(gadget_label.text.contains("1 available"), "rejection feedback expires")
		guard.call("advance_search", 5.0, (guard as Node3D).position)
		check(bool(agent.call("use_distraction")), "field distraction accepted by patrol")
		check(gadget_label.text.contains("deployed"), "successful use feedback")
		agent.call("advance_distraction_feedback", 2.0)
		check(gadget_label.text.contains("spent"), "success feedback expires")
		check(not bool(agent.call("use_distraction")) and not bool(agent.get("distraction_available")), "single charge per deployment")
		check(not bool(guard.get("ever_alerted")), "investigation is not confirmed alert")
		check(is_equal_approx(float(agent.get("crouch_speed")), 1.5), "selected movement kit applies in field")
		check(agent.position.is_equal_approx(relay_script.spawn_for(Campaign.relay_route())), "relay uses canonical entry")
		await get_tree().physics_frame
		await get_tree().physics_frame
		check(bool(mission.call("can_reach", mission.get("exit_point"))), "relay extraction reachable")
		agent.global_position = Vector3(0, 0.05, -7.1)
		await get_tree().physics_frame
		await get_tree().physics_frame
		check(bool(mission.call("can_reach", mission.get("intel_point"))), "relay drive reachable")
		if is_instance_valid(reserve):
			guard.call("enter_alert", true)
			var security_hud: Label = mission.get("security_label")
			check(security_hud.text.contains("Full alert recorded"), "security HUD records confirmed incident")
			check(bool(reserve.get("ever_alerted")) and not bool(reserve.get("has_last_seen")), "shared alert without shared position")
			reserve.call("advance_search", 5.0, reserve.position)
			guard.call("begin_search", true)
			guard.call("advance_search", 5.0, (guard as Node3D).position)
			guard.call("enter_alert", true)
			check(bool(reserve.get("search_from_alert")) and float(reserve.get("search_remaining")) > 0.0, "new alert episode reaches previously alerted guard")
			reserve.call("advance_search", 1.0, reserve.position)
			var remaining := float(reserve.get("search_remaining"))
			guard.call("enter_alert", false)
			check(is_equal_approx(float(reserve.get("search_remaining")), remaining), "continuous alert does not restart search")
			check(security_hud.text.contains("Full alert recorded"), "historical HUD remains after search cycles")
			reserve.call("receive_hit", 3)
			var aggregate: Dictionary = mission.call("security_summary")
			check(aggregate["count"] == 2 and aggregate["down"] == 1 and aggregate["alerted"], "aggregate security state")
			var report: Dictionary = mission.call("measure_field_report")
			check(report.get("alerted", false) and report.get("guard_down", false), "canonical report aggregates both guards")
	relay.queue_free()
	await get_tree().process_frame
