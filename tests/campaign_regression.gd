	check(Campaign.available_operations().has("night_relay") and Campaign.relay_route() == "independent", "failed contract unlocks independent relay")
	check(Campaign.field_report("silent_archive") == archive_report, "archive performance stored")
	check(handler.assessment(archive_report).contains("full alert and you took damage"), "grounded alert assessment")
	check(Campaign.record_archive({"seconds": 1}), "completed archive replay is ignored")
	check(Campaign.field_report("silent_archive") == archive_report, "archive replay preserves report")
	check(Campaign.available_credits() == 280, "canonical rewards cannot be farmed")
	check(Campaign.rook_contract_reward() == 0 and Campaign.rook_contract_status().begins_with("Closed"), "alert closes contract without bonus")
	check(Campaign.handler_trust() == -1 and Campaign.independent_leverage() == 1, "retain consequences")
	check(Campaign.can_negotiate_handler(), "negotiation unlocked")
	check(not Campaign.negotiate_handler("invalid"), "invalid agreement rejected")
	check(Campaign.negotiate_handler("coordinate"), "agreement saved")
	check(Campaign.handler_trust() == 0 and Campaign.independent_leverage() == 1, "agreement changes trust")
	check(Campaign.archive_intel_price() == 40 and Campaign.archive_intel_source() == "Handler", "coordination discount beats Rook quote")
	check(Campaign.buy_archive_intel(), "purchase recon")
	check(Campaign.owns_archive_intel() and Campaign.available_credits() == 240 and Campaign.archive_intel_source() == "Handler", "debit once and retain source")
	check(not Campaign.buy_archive_intel(), "duplicate recon purchase rejected")
	check(not Campaign.buy_equipment("invalid"), "unknown equipment rejected")
	check(Campaign.buy_equipment("light_armor"), "buy armor")
	check(not Campaign.buy_equipment("light_armor"), "duplicate equipment rejected")
	check(Campaign.available_credits() == 160, "equipment and recon debited")
	check(Campaign.buy_equipment("utility_rig"), "buy utility rig")
	check(Campaign.available_credits() == 90, "both equipment purchases debited")
	check(Campaign.independent_supplier_available(), "retained intelligence unlocks Rook")
	check(Campaign.rook_reputation() == 0 and Campaign.rook_relationship() == "New contact", "leverage is not Rook reputation")
	check(Campaign.buy_equipment("quiet_kit"), "buy independent movement kit")
	check(Campaign.rook_reputation() == 1 and Campaign.rook_message().contains("movement kit"), "Rook remembers real purchase")
	check(not Campaign.buy_equipment("quiet_kit") and Campaign.available_credits() == 25, "supplier debit once")
	check(not Campaign.negotiate_handler("autonomy"), "agreement cannot be farmed or changed")
	check(Campaign.intel_choice == "retain", "negotiation preserves route decision")
	check(Campaign.has_skill_point(), "mission awards one skill point")
	check(Campaign.record_intel("share"), "replay accepted")
	check(Campaign.intel_choice == "retain", "replay preserves canonical decision")
	check(Campaign.field_report("unexpected_guest")["seconds"] == 40, "replay preserves field report")
	check(Campaign.choose_specialization("resilience"), "spend skill point")
	check(not Campaign.has_skill_point(), "no additional point")
	check(not Campaign.choose_specialization("mobility"), "second specialization rejected")
	var saved := ConfigFile.new()
	check(saved.load("user://campaign.cfg") == OK, "load persisted campaign")
	check(saved.get_value("missions", Campaign.MISSION_ID, "") == "retain", "decision persisted")
	check(saved.get_value("progression", "specialization", "") == "resilience", "specialization persisted")
	check(not saved.has_section("deployment"), "kit excluded from persistence")
	Campaign.intel_choice = ""
	Campaign.specialization = ""
	Campaign.archive_completed = false
	Campaign.field_reports.clear()
	Campaign.handler_agreement = ""
	Campaign.archive_intel_cost = 0
	Campaign.rook_contract_accepted = false
	Campaign.rook_trust_penalty_enabled = false
	Campaign.equipment_owned.clear()
	Campaign.load_campaign()
	check(Campaign.handler_agreement == "coordinate", "agreement survives reload")
	check(Campaign.rook_contract_accepted and Campaign.rook_trust_penalty_enabled and Campaign.rook_contract_reward() == 0, "closed contract and terms survive reload")
	check(Campaign.rook_reputation() == 1 and Campaign.rook_relationship() == "Known client", "Rook relationship survives reload")
	check(Campaign.earned_credits() == 280 and Campaign.available_credits() == 25 and Campaign.owns_equipment("quiet_kit") and Campaign.owns_archive_intel() and Campaign.owns_equipment("light_armor") and Campaign.owns_equipment("utility_rig"), "equipment, recon and balance survive reload")
	check(Campaign.field_report("unexpected_guest").get("seconds") == 40 and Campaign.field_report("silent_archive") == archive_report, "reports survive specialization and reload")
	check(Campaign.archive_completed, "archive completion survives specialization and reload")
	check(Campaign.intel_choice == "retain" and Campaign.specialization == "resilience", "reload restores campaign")
	check(Campaign.select_deployment_kit("protection"), "select protection for field test")
	check(Campaign.select_deployment_equipment("light_armor"), "select owned armor")
	check(not Campaign.select_deployment_equipment("invalid") and Campaign.equipment_active("light_armor"), "invalid selection preserves slot")
	check(not Campaign.equipment_active("quiet_kit"), "single equipment slot")
	var hotel: Node = preload("res://scenes/hotel.tscn").instantiate()
	add_child(hotel)
	await get_tree().physics_frame
	var agent := hotel.get_node_or_null("Agent")
	check(is_instance_valid(agent), "hotel agent exists")
	if is_instance_valid(agent):
		check(int(agent.get("maximum_health")) == 160, "armor, resilience and protection stack")
		check(is_equal_approx(float(agent.get("crouch_speed")), 1.25), "unselected movement kit inactive")
		check(int(agent.get("health")) == 160, "spawn with full health")
		var combat: Node = agent.get("combat")
		check(is_instance_valid(combat), "field combat exists")
		if is_instance_valid(combat):
			check(int(combat.get("reserve")) == 16, "unselected utility rig inactive")
			var mark: MeshInstance3D = combat.get("impact_mark")
			check(is_instance_valid(mark) and mark.get_parent() == combat, "impact marker owned by combat node")
		var visual: Node3D = agent.get("model")
		var outfit: Node3D = visual.get("outfit")
		check(is_instance_valid(outfit) and outfit.get_child_count() == 4, "selected armor has distinct visual outfit")
		visual.call("trigger_shot")
		check(is_equal_approx(float(visual.get("shot_pose")), 1.0), "shot triggers visual pulse")
		visual.call("animate_pose", 0.2, 0.0, false, true, false)
		check(is_zero_approx(float(visual.get("shot_pose"))), "shot visual decays")
		visual.call("animate_pose", 0.1, 0.0, false, true, true)
		check(float(visual.get("reload_pose")) > 0.0, "reload visual blends")
	var guard := hotel.get_node_or_null("Guard")
	check(is_instance_valid(guard), "hotel guard exists")
	if is_instance_valid(guard):
		var guard_visual: Node3D = guard.get("body")
		check(is_instance_valid(guard_visual), "guard visual rig exists")
		if is_instance_valid(guard_visual):
			check(guard_visual.get("knees").size() == 2, "guard articulated knees")
			check(guard_visual.get("elbows").size() == 2, "guard articulated elbows")
		var guard_script = preload("res://scripts/guard.gd")
		var probe = guard_script.new()
		check(probe.request_distraction(), "patrol accepts fictional distraction")
		check(not probe.request_distraction(), "active investigation rejects repeated distraction")
		probe.update_detection(0.1, false)
		check(not probe.ever_alerted and probe.state == guard_script.GuardState.SUSPICIOUS, "curiosity does not instantly alert")
		probe.update_detection(2.0, false)
		check(probe.ever_alerted and probe.state == guard_script.GuardState.ALERT, "detection records alert immediately")
		check(not probe.request_distraction() and probe.ever_alerted, "distraction cannot erase full alert")
		probe.begin_search(true)
		probe.update_detection(0.01, true)
		check(probe.state == guard_script.GuardState.ALERT, "alerted search reacquires")
		probe.remember_sighting(Vector3(2, 0, 0))
		probe.begin_search(true)
		probe.advance_search(0.1, Vector3.ZERO)
		check(probe.search_moving and probe.velocity.x > 0.0, "search uses stored sighting")
		probe.advance_search(0.1, Vector3(2, 0, 0))
		check(not probe.search_moving and is_zero_approx(probe.velocity.x), "search scans after arrival")
		probe.advance_search(5.0, Vector3(2, 0, 0))
		check(probe.state == guard_script.GuardState.PATROL and not probe.has_last_seen and probe.ever_alerted, "search expires without clearing alert history")
		check(is_zero_approx(guard_script.forward_progress(Vector3.RIGHT, Vector3.BACK)), "sideways sliding is not waypoint progress")
		check(is_zero_approx(guard_script.forward_progress(Vector3.RIGHT, Vector3.LEFT)), "backward movement is not progress")
		check(is_equal_approx(guard_script.forward_progress(Vector3.RIGHT, Vector3(1, 4, 2)), 1.0), "only forward planar velocity counts")
		var initial_waypoint: int = probe.waypoint
		probe.observe_patrol_progress(0.6, true, 0.0)
		check(probe.waypoint == initial_waypoint, "transient stall does not skip waypoint")
		probe.observe_patrol_progress(0.1, true, 1.45)
		check(is_zero_approx(probe.patrol_stall_time), "movement resets stall timer")
		probe.observe_patrol_progress(1.3, false, 0.0)
		check(probe.waypoint == initial_waypoint, "intentional pause does not skip waypoint")
		probe.observe_patrol_progress(1.3, true, 0.0)
		check(probe.waypoint != initial_waypoint and probe.pause_time > 0.0, "sustained stall advances authored waypoint")
		check(probe.ever_alerted, "patrol recovery preserves alert history")
		probe.free()
	if is_instance_valid(agent):
		var field_agent := agent as CharacterBody3D
		field_agent.set_physics_process(false)
		field_agent.global_position = Vector3(-3.65, 0.05, 6.65)
		field_agent.rotation.y = 0.0
		await get_tree().physics_frame
		await get_tree().physics_frame
